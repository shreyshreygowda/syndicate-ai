# Temporarily disable login (set to false to re-enable auth)
DISABLE_AUTH=true

# Required — generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# App URL (use your device IP or domain for self-hosting)
NEXTAUTH_URL=http://localhost:3000

# Database (SQLite, stored locally)
DATABASE_URL=./data/syndicate.db

# LLM Provider API Keys (at least one required)
FIREWORKS_API_KEY=fw_xxxxxxxx
OPENROUTER_API_KEY=sk-or-xxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional: force 2FA for all users
REQUIRE_2FA=true

# Optional: disable search engine indexing
NOINDEX=true
